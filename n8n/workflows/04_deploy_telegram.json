      "position": [0, 0],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "TradeHub Telegram bot"
        }
      },
      "notes": "Fires when the owner taps a button under a signal card. Only callback_query updates are subscribed — ordinary chat messages are ignored."
    },
    {
      "parameters": {
        "method": "POST",
