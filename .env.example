# TradeHub secrets and settings. Copy to .env and fill in. Never commit .env.

# --- LLM ---
OPENROUTER_API_KEY=
# Better tier (narrator, Fed explainer). Confirm the model with the owner.
OPENROUTER_MODEL_BETTER=nousresearch/hermes-4-405b
# Cheap tier (condenser). Decided by eval_models.py in Phase 4.
OPENROUTER_MODEL_CHEAP=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
LLM_MONTHLY_BUDGET_EUR=5

# --- Data sources with keys ---
MASSIVE_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
TIINGO_API_KEY=
TWELVEDATA_API_KEY=
BLS_API_KEY=

# --- Data sources without keys today (fill only if the provider starts requiring one) ---
STOOQ_API_KEY=

# --- PostgreSQL (Docker, internal network only) ---
POSTGRES_USER=tradehub
POSTGRES_PASSWORD=
POSTGRES_DB=tradehub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Internal services ---
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=
# n8n sends this header when it triggers a job
N8N_TRIGGER_SECRET=

# --- Host ports (all bound to 127.0.0.1) ---
API_PORT=8100
SEARXNG_PORT=8888
N8N_PORT=5680

# --- Optional, later phases ---
SENTRY_DSN=
DATABENTO_API_KEY=
