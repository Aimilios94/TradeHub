# TradeHub environment — copy to .env and fill in. NEVER commit .env.
# Keys live here (engine) and in n8n's credentials store. The frontend never sees any of them.
# Grouped by the phase in which each key is first needed.

# ---------- General ----------
TRADEHUB_ENV=dev                      # dev | paper | live
TRADEHUB_TZ=America/New_York          # all crons and market logic run in ET
PAPER_MODE=true                       # live requires an explicit switch (Phase 8 onboarding)

# ---------- Phase 0/1 — Supabase ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=                    # frontend-safe key (Phase 9)
SUPABASE_SERVICE_ROLE_KEY=            # engine + n8n only, bypasses RLS
SUPABASE_DB_URL=                      # postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ---------- Phase 1 — Alpaca (PAPER keys only until go-live; live keys are separate credentials) ----------
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex                  # iex (free) | sip (Algo Trader Plus upgrade, see plan §31)
# ALPACA_LIVE_KEY_ID=                 # entered only at go-live (plan §16)
# ALPACA_LIVE_SECRET_KEY=

# ---------- Phase 2 — Finviz Elite (screener CSV export) ----------
FINVIZ_ELITE_AUTH_TOKEN=              # the auth token embedded in the Elite export URL
FMP_API_KEY=                          # backup float data, fundamentals (free tier)

# ---------- Phase 3 — Sentiment sources ----------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tradehub/0.1 by <your_reddit_username>
FINNHUB_API_KEY=
FIRECRAWL_API_KEY=                    # last resort only
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=hermes3:8b

# ---------- Phase 4 — Hosted Hermes ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL_JUDGMENT=nousresearch/hermes-3-llama-3.1-70b
OPENROUTER_MODEL_HIGH_STAKES=nousresearch/hermes-3-llama-3.1-405b

# ---------- Phase 5 — Execution & alerts ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_WEBHOOK_SECRET=                   # shared HMAC secret between n8n and the engine
ENGINE_API_TOKEN=                     # bearer token n8n sends to the engine

# ---------- Phase 6+ — Macro & extensions ----------
FRED_API_KEY=
EIA_API_KEY=
TWELVEDATA_API_KEY=                   # backup only: index values + VIX display

# ---------- Engine runtime ----------
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
PARQUET_STORE_PATH=./data/parquet     # deep 1-min history for the backtester (plan §5 bar policy)
LOG_LEVEL=INFO
